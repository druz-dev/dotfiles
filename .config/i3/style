for_window [class=".*"] border pixel 1
gaps outer 0
gaps inner 0
#border_radius 2
#smart_borders on
smart_gaps on

## Font
font pango:TerminessTTF Nerd Font Mono Bold 14

## Colors
set $x	#FF0000
set $urgent #FF8000
set $focus	#7555FF
set $ufocus	#171b3366
# set $ufocus	#00000022

client.focused			$x $x $x $focus  $focus
client.focused_inactive	$x $x $x $ufocus $ufocus
client.unfocused		$x $x $x $ufocus $ufocus
client.urgent			$x $x $x $urgent $urgent

set $bg #1B1F3B98
set $it #443883
set $t  #7555FF


